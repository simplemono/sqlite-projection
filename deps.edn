{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
        com.github.seancorfield/honeysql {:mvn/version "2.6.1230"}
        org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}
        simplemono/event-store-core {:git/url "https://github.com/simplemono/event-store.git"
                                     :sha "d6d2d130bb88832bb855fbb4a97313727ab96e13"
                                     :deps/root "core"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {simplemono/event-store-memory {:git/url "https://github.com/simplemono/event-store.git"
                                                     :sha "d6d2d130bb88832bb855fbb4a97313727ab96e13"
                                                     :deps/root "memory"}}
         :main-opts ["-m" "simplemono.sqlite-projection-test"]}

  ;; Run the tests against a sibling checkout of the event-store repo:
  ;; clojure -M:test:local
  :local {:override-deps {simplemono/event-store-core {:local/root "../event-store/core"}
                          simplemono/event-store-memory {:local/root "../event-store/memory"}}}}}
